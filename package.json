{
  "name": "sans-ui",
  "version": "0.1.0",
  "description": "Standalone, high-performance React UI component library based on strict TypeScript and CSS Modules",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./styles.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.0.21",
    "@fontsource/lato": "^5.0.21",
    "@fontsource/poppins": "^5.0.14",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^6.6.0",
    "react-day-picker": "^8.10.1",
    "react-map-gl": "^8.1.2"
  },
  "devDependencies": {
    "@fontsource/andada-pro": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/slabo-13px": "^5.3.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.3"
  },
  "style": "./dist/style.css"
}
